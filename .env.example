# ========================================================
# SENTINEL-X AI Agent Security Guardian - Environment Config
# ========================================================

# Host & Port Configurations
HOST=127.0.0.1
PORT=8000

# Database Connection (Default SQLite for local demo mode)
# For production PostgreSQL, use: postgresql://user:password@localhost:5432/sentinel_x
DATABASE_URL=sqlite:///./sentinel_x.db

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=info

# Demo Security Mode Credentials (Placeholders only)
ADMIN_SECRET_KEY=demo_placeholder_change_in_production
